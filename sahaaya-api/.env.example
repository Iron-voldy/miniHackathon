NODE_ENV=development
PORT=8080

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sahaaya?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - add every origin your frontend runs on (dev + deployed)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# OpenAI - phrase ranking (optional AI feature)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=2000

# Azure Speech - TTS (Sinhala si-LK, Tamil ta-LK neural voices)
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_TIMEOUT_MS=2000

# Caregiver email alerts on new requests (optional - skipped if SMTP_HOST is unset)
EMAIL_FROM=sahaaya@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=...
SMTP_PASSWORD=...
EMAIL_TIMEOUT_MS=3000
